rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    match /pianoNeveUsers/{uid} {
      allow read, write: if own(uid);
      match /sessions/{sessionId} { allow read, write: if own(uid); }
      match /giri/{giroId} { allow read, write: if own(uid); }
      match /{document=**} { allow read, write: if own(uid); }
    }
  }
}
