// ISOLATED FIRESTORE EMULATOR TEST FIXTURE — NOT FOR DEPLOYMENT.
// This file covers ONLY piano-neve paths. Never replace the production project rules with it.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
   function signedIn() { return request.auth != null; }
   function profilePath() {
     return /databases/$(database)/documents/platformUsers/$(request.auth.uid);
   }
   function profile() { return get(profilePath()).data; }
   function enabled() {
     return signedIn() && exists(profilePath())
       && profile().get('banned', false) != true
       && profile().get('statoAccount', profile().get('accountStatus', '')) in
          ['attivo','active','approvato','approved'];
   }
   function role() { return profile().get('role', profile().get('ruolo', 'operatore')); }
   function admin() { return enabled() && role() == 'admin'; }
   function office() { return enabled() && (role() == 'ufficio' || role() == 'admin'); }
   function self(uid) { return enabled() && request.auth.uid == uid; }
   function ownPayload() {
     return request.resource.data.uid == request.auth.uid
       && request.resource.data.userEmail == request.auth.token.email;
   }
   match /platformUsers/{uid} {
     allow get: if signedIn() && request.auth.uid == uid;
     allow list, create, update, delete: if false;
   }
   match /pianoNeveUsers/{uid} {
     allow get: if self(uid);
     allow list: if false;
     allow create, update, delete: if self(uid);
     match /sessions/{sessionId} {
       allow get: if self(uid) && sessionId == 'active';
       allow list: if false;
       allow create, update: if self(uid) && sessionId == 'active' && ownPayload();
       allow delete: if self(uid) && sessionId == 'active';
     }
     match /giri/{giroId} {
       allow get, list: if self(uid);
       allow create: if self(uid) && admin() && ownPayload() && request.resource.data.archiveId == giroId;
       allow update: if self(uid) && admin() && ownPayload()
          && resource.data.uid == request.resource.data.uid
          && resource.data.archiveId == request.resource.data.archiveId;
       allow delete: if false;
     }
   }
   match /pianoNeveStreetWork/{recordId} {
     allow get, list: if admin() || (enabled() && resource.data.uid == request.auth.uid);
     allow create: if enabled() && ownPayload() && request.resource.data.recordId == recordId;
     allow update: if enabled() && ownPayload()
       && resource.data.uid == request.auth.uid
       && resource.data.recordId == recordId
       && request.resource.data.recordId == recordId;
     allow delete: if false;
   }
   // Phase 2 — isolated emulator permissions, NOT production rules.
   function knownRoute(routeKey, routeId) {
     return (routeKey == 'major_0' && routeId == 'major:0')
       || (routeKey == 'major_1' && routeId == 'major:1')
       || (routeKey == 'major_2' && routeId == 'major:2')
       || (routeKey == 'minor_0' && routeId == 'minor:0')
       || (routeKey == 'minor_1' && routeId == 'minor:1')
       || (routeKey == 'minor_2' && routeId == 'minor:2')
       || (routeKey == 'minor_3' && routeId == 'minor:3');
   }
   function allowedStatus() {
     return request.resource.data.status in ['active', 'released'];
   }
   match /pianoNeveVehicles/{vehicleId} {
     allow get, list: if admin();
     allow create, update: if admin()
       && request.resource.data.name is string && request.resource.data.name.size() <= 90
       && request.resource.data.active is bool
       && request.resource.data.updatedBy == request.auth.uid;
     allow delete: if false;
   }
   match /pianoNeveTeams/{teamId} {
     allow get, list: if admin();
     allow create, update: if admin()
       && request.resource.data.name is string && request.resource.data.name.size() <= 90
       && request.resource.data.operatorUid is string
       && request.resource.data.active is bool
       && request.resource.data.updatedBy == request.auth.uid;
     allow delete: if false;
   }
   match /pianoNeveAssignments/{routeKey} {
     allow get, list: if admin() || (enabled() && resource.data.operatorUid == request.auth.uid);
     allow create: if admin() && allowedStatus()
       && request.resource.data.status == 'active'
       && request.resource.data.createdBy == request.auth.uid
       && knownRoute(routeKey, request.resource.data.routeId)
       && request.resource.data.operatorUid is string
       && request.resource.data.teamId is string
       && request.resource.data.vehicleId is string;
     allow update: if admin() && allowedStatus()
       && knownRoute(routeKey, request.resource.data.routeId)
       && request.resource.data.routeId == resource.data.routeId
       && request.resource.data.operatorUid is string
       && request.resource.data.teamId is string
       && request.resource.data.vehicleId is string
       && (
         (resource.data.status == 'active' && request.resource.data.status == 'released'
           && request.resource.data.operatorUid == resource.data.operatorUid)
         || (resource.data.status == 'released' && request.resource.data.status == 'active'
           && request.resource.data.createdBy == request.auth.uid)
       );
     allow delete: if false;
   }
   function validLivePosition(uid) {
     return request.resource.data.uid == uid && request.auth.uid == uid
       && request.resource.data.lat is number
       && request.resource.data.lng is number
       && request.resource.data.accuracy is number
       && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
       && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
       && request.resource.data.accuracy >= 0 && request.resource.data.accuracy <= 100
       && knownRoute(request.resource.data.routeKey, request.resource.data.routeId)
       && request.resource.data.updatedAt == request.time
       && get(/databases/$(database)/documents/pianoNeveAssignments/$(request.resource.data.routeKey)).data.operatorUid == uid
       && get(/databases/$(database)/documents/pianoNeveAssignments/$(request.resource.data.routeKey)).data.status == 'active'
       && get(/databases/$(database)/documents/pianoNeveAssignments/$(request.resource.data.routeKey)).data.teamId == request.resource.data.teamId
       && get(/databases/$(database)/documents/pianoNeveAssignments/$(request.resource.data.routeKey)).data.vehicleId == request.resource.data.vehicleId;
   }
   match /pianoNeveLivePositions/{uid} {
     allow get, list: if admin() || (enabled() && request.auth.uid == uid);
     allow create, update: if enabled() && validLivePosition(uid);
     allow delete: if enabled() && request.auth.uid == uid;
   }
   match /pianoNeveRouteEdits/{editId} {
     allow get, list: if enabled();
     allow create: if admin() && ownPayload() && request.resource.data.editId == editId;
     allow update, delete: if admin();
   }
 }
}
